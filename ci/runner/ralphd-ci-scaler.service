# systemd user unit for the elastic runner pool scaler (docs/ci.md, "Adopting the
# elastic pool"). Install: copy to ~/.config/systemd/user/, adjust ExecStart to
# where this repository is checked out, then
#   systemctl --user daemon-reload && systemctl --user enable --now ralphd-ci-scaler
[Unit]
Description=ralphd CI elastic runner pool scaler
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/ralphd/ci/runner_scaler.py --config %h/.config/ralphd-ci/scaler.yaml run
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
