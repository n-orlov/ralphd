    tasks = d["tasks"]
    picked = next((t for t in tasks if t.get("id") == assigned_id), None) \
        if assigned_id else None
    if picked is not None:
        if (os.environ.get("STUB_REWRITE_CRITERIA")
                and picked.get("validationAttempts", 0) >= 1):
            # A worker that failed verification once and then cheats by
            # rewriting the criteria instead of the actual work (task 008).
            # This is the one field a worker may still edit directly --
            # `successCriteria`, not `status` -- since the harness's own
            # contract-applied move only ever touches the latter.
            picked["successCriteria"] = (
                picked.get("successCriteria", "") + " (rewritten by worker)")
            with open(tasks_file, "w") as f:
                json.dump(d, f)
        time.sleep(float(os.environ.get("STUB_SLEEP", "0")))
    # record steering whenever a worker iteration sees it. Anchor on the
    # engine's *injected* header (loop.py writes
    # "## Operator steering (MUST take priority)" / "... (pending, ...)"),
    # not on the bare words, which also appear in worker.md's own prose about
    # how to handle steering. Take the last occurrence so appended context
    # cannot shadow it.
    steering_marker = "## Operator steering ("
    if steering_marker in prompt:
        with open(marker("saw-steering"), "a") as f:
            f.write(prompt[prompt.rindex(steering_marker):][:2000])
    if picked is None:
        # Nothing was assigned this iteration -- either the plan is
        # already fully resolved (task 015, requirement O/#100: report it
        # through the `verdict: "plan_complete"` contract value, the
        # retired `<promise>COMPLETE</promise>` marker's replacement --
        # valid precisely because nothing was assigned, matching worker.md's
        # own "never both in the same reply" rule for the per-task verdict),
        # or something failed with nothing actionable left (#33) and this
        # stub has no adversarial behaviour to offer for that case -- a
        # plain no-op reply lets the engine's own blocked-with-failures
        # routing (task 024) take it from here.
        if all(t["status"] in _PLAN_FULLY_RESOLVED_STATUSES for t in tasks):
            text = "everything finished"
            if echo_secrets:
                text += " secrets: " + " ".join(echo_secrets) + " NONSECRET_SENTINEL_9f3a"
            text += "\n" + json.dumps({"verdict": "plan_complete"})
            emit_final(text, tool_call=tool_call, thinking_text=thinking_text)
        else:
            emit_final("nothing assigned this iteration and something is "
                       "blocked", tool_call=tool_call, thinking_text=thinking_text)
    else:
        # Task 120 (#60): STUB_UNSATISFIABLE_TASK_IDS lets a test make the
        # worker report a task's criteria as unmeetable AS WRITTEN, through
        # the same `verdict: "unsatisfiable"` contract path task 025 (#63)
        # implemented -- the harness moves the named task to `skipped`
        # (dead, per `state.TASK_DEPENDENCY_DEAD_STATUSES`), a legitimate
        # way to make a task genuinely dead for a dependency-blocking test
        # without smuggling a `status` through the planner's contract.
        _unsat_ids = [s for s in
                      os.environ.get("STUB_UNSATISFIABLE_TASK_IDS", "").split(",")
                      if s]
        if picked["id"] in _unsat_ids:
            text = f"task {picked['id']} cannot be satisfied as written"
            text += "\n" + json.dumps({
                "verdict": "unsatisfiable", "task_id": picked["id"],
                "reason": "stub: criteria unmeetable as written"})
            emit_final(text, tool_call=tool_call, thinking_text=thinking_text)
        else:
            # Task 116: report the outcome through the contract instead of
            # writing tasks.json's `status` field directly -- the harness
            # applies `awaiting-validation`/`completed` itself from this
            # payload, the SAME transitions.task_status_report_errors path
            # review/reflect already go through.
            text = f"completed {picked['id']}"
            # Task 123 (#60): task 116 dropped the stable human-readable closing
            # line a completed-plan worker iteration used to emit inline (the
            # old code mutated tasks.json itself and could see the post-write
            # state; the new stub can no longer write status, only predict it).
            # Predict the outcome the harness will apply to THIS payload under
            # the default non-vigilant contract (`complete` -> `completed`,
            # matching `_TASK_SATISFIES_DEPENDENCY`/`_PLAN_FULLY_RESOLVED_
            # STATUSES` above): if every OTHER task is already resolved, this
            # report finishes the plan in the same iteration that used to say
            # so, so keep saying so -- tests/test_cli_logs.py and
            # tests/test_cli_logs_follow_liveness.py assert on this literal
            # line, unmodified in intent since before task 116.
            others = [t for t in tasks if t.get("id") != picked["id"]]
            if all(t["status"] in _PLAN_FULLY_RESOLVED_STATUSES for t in others):
                text += "\neverything finished"
            if echo_secrets:
                text += " secrets: " + " ".join(echo_secrets) + " NONSECRET_SENTINEL_9f3a"
            _payload = {"verdict": "complete", "task_id": picked["id"]}
            # Task 005 (G.5): STUB_WORKER_PETITION rides alongside the
            # ordinary completion verdict, exactly as worker.md allows --
            # the engine (never this stub) is what turns the three declared
            # strings into a tracked filing.
            _petition = _declare_worker_petition()
            if _petition is not None:
                _payload["petition"] = _petition
            text += "\n" + json.dumps(_payload)
            emit_final(text, tool_call=tool_call, thinking_text=thinking_text)

elif "Role: Steer" in prompt:
    # Task 012 (PRD requirement I, #98): the steer hat is REACHABLE in a
    # real run for the first time as of this task -- `_step_worker` now
    # takes the declared `worker -> steer` edge whenever unsettled steering
    # exists, and dispatches a real subprocess through this same stub, not
    # only through `LoopSupervisor` unit tests with a scripted `sup.runner`.
    # Record what this iteration actually saw (same `saw-steering` shape
    # the Worker branch above already uses) so a test can assert the
    # steer hat's own prompt carried the real message body -- possible
    # only because `STEERING_ACTIONABLE_PHASES` gained `"steer"` in this
    # same commit (`build_prompt` would otherwise hand this phase only the
    # filename-only "pending, not for this phase" echo).
    steering_marker = "## Operator steering ("
    if steering_marker in prompt:
        with open(marker("saw-steering"), "a") as f:
            f.write(prompt[prompt.rindex(steering_marker):][:2000])
    # Task 030 (G.2, #130): STUB_STEER_TOOL_CALLS drives the REAL hat-side
    # client, one subprocess per call, exactly as the generated `pi`
    # extension's `callEngine()` would -- this crosses the SAME
    # request/response spool the engine's own broker is serving from the
    # other side, in the parent process (the engine, the sole writer of
    # everything a tool call performs). Never imports `hat_tools` in THIS
    # process: doing so would prove nothing about the cross-process spool
    # the in-process broker tests (`tests/test_steer_hat_tools_live.py`)
    # already cover -- the whole point here is a second real OS process.
    # Who this process IS, and whether it could write `tasks.json` itself --
    # recorded unconditionally, because it is the premise of every spool
    # test rather than a scenario of its own. The probe opens the file "r+"
    # (no write, no truncation: `open(..., "w")` would destroy the run's
    # task record on any host where the hat uid CAN write it, e.g. this
    # repo's own fast lane) purely to collect the kernel's permission answer.
    _probe_errno = None
    try:
        with open(os.path.join(run, "tasks.json"), "r+"):
            pass
    except OSError as _probe_exc:
        _probe_errno = _probe_exc.errno
    with open(os.path.join(run, ".stub-steer-uid.json"), "w") as f:
        f.write(json.dumps({"uid": os.getuid(), "euid": os.geteuid(),
                            "gid": os.getgid(), "egid": os.getegid(),
                            "tasksOpenRwErrno": _probe_errno}))
    _raw_calls = os.environ.get("STUB_STEER_TOOL_CALLS")
    if _raw_calls:
        import subprocess as _steer_subprocess
        _responses = []
        for _call in json.loads(_raw_calls):
            _proc = _steer_subprocess.run(
                [sys.executable, "-m", "ralphd.engine.hat_tools", _call["tool"]],
                input=json.dumps(_call.get("args") or {}),
                env={**os.environ, "RALPHD_HAT_TOOLS_RUN": run},
                capture_output=True, text=True)
            _stdout = _proc.stdout.strip()
            try:
                _responses.append(json.loads(_stdout))
            except json.JSONDecodeError:
                _responses.append({"ok": False,
                                   "error": "stub: unparseable client stdout: "
                                            + repr(_stdout) + " / " + repr(_proc.stderr)})
        with open(os.path.join(run, ".stub-steer-tool-responses.json"), "w") as f:
            f.write(json.dumps(_responses))
    # STUB_STEER_MALFORMED_REQUEST: a hand-written, deliberately-unparseable
    # request file dropped straight into the spool -- never through
    # `hat_tools.call()`, which always writes valid JSON -- to prove the
    # broker answers it (`ok: false`, `SteerToolBroker.serve_once()`'s
    # `except (OSError, json.JSONDecodeError)` branch) instead of choking or
    # ending the run. Fixed id, so the test can read the answer straight out
    # of `hat-tools/responses/stub-malformed.json` afterwards.
    if os.environ.get("STUB_STEER_MALFORMED_REQUEST"):
        _reqdir = os.path.join(run, "hat-tools", "requests")
        os.makedirs(_reqdir, exist_ok=True)
        with open(os.path.join(_reqdir, "stub-malformed.json"), "w") as f:
            f.write("{this is not valid json,,,")
    # This stub has no OTHER adversarial steer-hat behaviour to offer -- it
    # settles every pending message with no plan change, which is enough to
    # prove the routing/consumption plumbing end to end. `settled: true` is
    # the WHOLE contract (`transitions.HAT_SCHEMAS["steer"]`).
    emit_final("steering settled (stub: no plan change)\n"
              + json.dumps({"settled": True}))

