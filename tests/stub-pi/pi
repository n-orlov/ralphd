#!/usr/bin/env python3
"""Stub `pi` for black-box engine tests.

Reads the phase prompt on stdin, emits pi-shaped NDJSON on stdout, and mutates
run-dir state files the way a real agent iteration would. Scenario knobs come
from env vars set by the test:

  STUB_RUN_DIR        run dir (required)
  STUB_TASKS          number of tasks the planner creates (default 2)
  STUB_UNSATISFIABLE_TASK_IDS  comma-separated task ids (task 120, #60): the
                      first worker iteration assigned one of these ids
                      reports `verdict: "unsatisfiable"` (task_id + a stub
                      reason) through the worker contract instead of the
                      ordinary completion payload -- the harness applies
                      this by moving that task to `skipped`
                      (`state.TASK_DEPENDENCY_DEAD_STATUSES`), a real,
                      already-implemented way for a black-box test to make
                      a task genuinely dead without smuggling a `status`
                      through the planner's contract (which task 120's
                      lint now refuses outright).
  STUB_HOLD_FILE      task 007 (B.1): a bounded, env-driven hold primitive
                      every phase's invocation applies BEFORE its own
                      role logic runs. When set, this invocation blocks
                      until the named path exists on disk (the test's own
                      release signal, e.g. `path.touch()` once the test has
                      observed whatever it needed mid-iteration) OR
                      STUB_HOLD_TIMEOUT_S seconds elapse (default 5.0 -- a
                      SMALL bounded fallback, never anything close to the
                      real iteration timeout), whichever comes first.
                      Released -> the invocation proceeds to its ordinary
                      role logic. NOT released by the bound -> this is a
                      test bug, and the stub treats it as one: it writes
                      `stub: hold ... never released` to stderr naming the
                      bound and EXITS NONZERO (exit code 3) without
                      emitting any role payload, so the invoking test
                      FAILS on the bound instead of hanging or quietly
                      passing on a window that never opened. The actual
                      wait duration (seconds) is always recorded to
                      `STUB_HOLD_FILE + ".stub-hold-duration"`, released or
                      timed out either way, so a test can assert its own
                      recorded duration stayed within the bound plus a
                      stated margin.
  STUB_HOLD_TIMEOUT_S the fallback bound (seconds) for STUB_HOLD_FILE above
                      (default 5.0). Ignored when STUB_HOLD_FILE is unset.
                      Exceeding it is a failure (exit code 3), never a
                      silent continue.
  STUB_HOLD_POLL_S    poll interval (seconds) while waiting on STUB_HOLD_FILE
                      (default 0.02). Ignored when STUB_HOLD_FILE is unset.
  STUB_REVIEW_FAILS   how many reviews reject before verifying (default 0)
  STUB_WORKER_PETITION  task 005 (G.5): a JSON object with the three
                      strings a worker's structured impossibility petition
                      declares (`obligation`, `type`, `evidence`,
                      `docs/petition-format.md`). The FIRST worker
                      invocation that reports an ordinary
                      `verdict: "complete"` carries it on that same
                      payload's `petition` field (its own marker file, so
                      exactly one declaration is made however many worker
                      iterations the flow takes -- a second filing of the
                      same obligation is a duplicate the engine refuses).
                      Because `petitions.file_worker_petition` only ever
                      files into a `<wave>-petitions.md` that already
                      exists under the workspace's `artifacts/reports/`,
                      the same invocation first creates that file if the
                      workspace carries none (cwd IS the workspace for a
                      real `pi` iteration) -- the pre-created petitions
                      file a real wave's planning phase places. The wave
                      token is STUB_PETITIONS_WAVE (default `v0.0`).
  STUB_REVIEW_ADJUDICATIONS  task 005 (G.5): a JSON array of
                      `petition_adjudications` entries (`obligation` plus
                      `adjudication`: `CONFIRMED`/`REFUTED`, a REFUTED one
                      also carrying `remedy`) -- `HAT_SCHEMAS["review"]`'s
                      own optional field. Every VERIFYING review reply
                      carries them, which includes the bounded mid-run
                      adjudication episode the engine runs on the review
                      hat's own model while a petition is open
                      (`_maybe_run_midrun_adjudication_episode`); the
                      engine's own write paths are idempotent, so a later
                      ordinary review pass repeating the same entries
                      neither double-appends the adjudication line in the
                      tracked file nor rewrites the run-scope record.
  STUB_REVIEW_CURABLE_REJECT_COUNT  task 023 (C.3, #141): how many `review`
                      invocations reject with an all-curable BLOCKING
                      findings channel before the next one verifies
                      (mirrors STUB_VERDICT_GATE_REJECT_COUNT's own "N
                      times, then approve" shape, with its own marker
                      file and its own counter, so it composes with
                      STUB_REVIEW_FAILS/STUB_REVIEW_MALFORMED_COUNT
                      without disturbing either). Checked BEFORE
                      STUB_REVIEW_FAILS (but AFTER STUB_REVIEW_MALFORMED_
                      COUNT, same precedence order as the malformed knob's
                      own comment describes), so a test that only sets
                      this one gets exactly "reject once with curable
                      findings, then verify" -- the cure-pass scenario
                      `_review_cure_pass_available` exists for. Every
                      rejecting invocation writes BOTH the free-markdown
                      `review-findings.md` (`findings_path` in the
                      payload) and the structured sidecar `review-
                      findings.json` -- one BLOCKING, `curable: true`
                      finding, matching `engine.findings.FINDING_SCHEMA`.
                      Once the count is spent, the next (verifying)
                      invocation removes any `review-findings.json` this
                      knob wrote, so the engine's own "a verified claim
                      may never contradict a still-present blocking
                      finding" check (`_review_verdict`) never refuses it
                      for a channel that is no longer true.
  STUB_REVIEW_MALFORMED_COUNT  task 033 (G.5, #130): like
                      STUB_REVIEW_FAILS's own "N times, then verify" shape
                      but with NO parseable `review` contract payload at
                      all (prose, no JSON), so it trips the engine's own
                      uncharged re-ask ladder instead of the well-formed
                      `rejected` verdict STUB_REVIEW_FAILS emits -- checked
                      first, against the SAME `review-count` marker index,
                      so combining the two knobs is well-defined but no
                      test in this tree needs to. The ladder's re-asks fall
                      to this stub's `else` branch (no `Role: Reviewer`
                      marker in the re-ask prompt) and are also
                      unparseable, so it exhausts naturally.
  STUB_PLAN_REVIEW_OBJECTIONS  how many `plan_review` invocations object
                      (verdict "objected", a stub reason) before the next one
                      approves (default 0) -- task 029 (#130): 0 is the
                      plain-approval scenario, >=1 is the objection-then-
                      revision scenario (the engine routes an `objected`
                      reply with revision budget left back to `planning`,
                      which re-invokes this same stub's `Role: Planner`
                      branch, so the next `plan_review` invocation is the
                      one that approves). Counted with its own marker file,
                      independent of every other counter in this stub.
  STUB_VERDICT_GATE_REJECT  if set, every `verdict_gate` invocation rejects
                      (verdict "rejected", a stub reason) instead of
                      approving (task 029, #130) -- unset is the plain-
                      approval scenario.
  STUB_VERDICT_GATE_REJECT_COUNT  task 031 (G.3, #130): how many
                      `verdict_gate` invocations reject before the next one
                      approves (mirrors STUB_PLAN_REVIEW_OBJECTIONS's own
                      "N times, then approve" shape one level up, with its
                      own marker file). Takes precedence over the plain
                      boolean STUB_VERDICT_GATE_REJECT when both are set, so
                      a second, later approach's gate invocation can
                      genuinely approve rather than rejecting forever. Every
                      rejecting invocation writes BOTH the free-markdown
                      `verdict-gate-findings.md` (`findings_path` in the
                      payload) and the structured sidecar `verdict-gate-
                      findings.json` -- one finding, matching `engine.
                      findings.FINDING_SCHEMA`, deliberately with no
                      `author` field set, so a test reading the archived
                      copy back can prove the engine's own attribution
                      (`findings.attribute_authorship`), not the hat's
                      say-so, is what put `author: "verdict_gate"` there.
  STUB_VERDICT_GATE_MALFORMED_COUNT  task 033 (G.5, #130): how many of the
                      FIRST `Role: Peer verdict gate (BLIND)` invocations
                      reply with NO parseable `verdict_gate` contract
                      payload at all (prose, no JSON) -- its own marker
                      file, checked BEFORE STUB_VERDICT_GATE_REJECT_COUNT/
                      STUB_VERDICT_GATE_REJECT, so a later invocation (e.g.
                      a second approach's own gate call) can still approve
                      normally. The ladder's re-asks fall to this stub's
                      `else` branch (no `Role: Peer verdict gate` marker in
                      the re-ask prompt) and are also unparseable, so it
                      exhausts naturally.
  STUB_STEER_TOOL_CALLS  task 030 (G.2, #130): a JSON array of
                      `{"tool": ..., "args": {...}}` objects. A `Role: Steer`
                      invocation issues each one through the REAL hat-side
                      client (`python -m ralphd.engine.hat_tools <tool>`,
                      spawned as its OWN subprocess exactly as the generated
                      `pi` extension's `callEngine()` does, with
                      `RALPHD_HAT_TOOLS_RUN` pointed at the run dir) rather
                      than importing `hat_tools` in-process -- the call
                      crosses the same process boundary the engine's broker
                      is serving on the OTHER side of the spool. Every
                      response is collected and written to
                      `.stub-steer-tool-responses.json` (a JSON array, same
                      order) for the test to read.
                      Every `Role: Steer` invocation ALSO writes
                      `.stub-steer-uid.json` unconditionally: the uid/euid/gid
                      the hat's own process actually runs as, plus the errno of
                      a NON-destructive `open(<run>/tasks.json, "r+")` probe
                      (`tasksOpenRwErrno`, null when the open succeeded -- the
                      file is never written or truncated by the probe). Under
                      the real container boundary that errno is EACCES: the hat
                      uid cannot write the task record at all, which is the
                      whole reason the spool exists (see
                      `tests/test_steer_tool_spool_two_uid_docker_task030.py`).
  STUB_STEER_MALFORMED_REQUEST  if set, a `Role: Steer` invocation ALSO
                      drops one hand-written, deliberately-unparseable file
                      straight into `<run>/hat-tools/requests/` (never
                      through `hat_tools.call()`, which always writes valid
                      JSON) -- the malformed-client shape
                      `SteerToolBroker.serve_once()`'s `except (OSError,
                      json.JSONDecodeError)` branch exists for. The request
                      id is fixed (`stub-malformed`), so the test can read
                      its answer straight out of
                      `hat-tools/responses/stub-malformed.json` afterwards.
  STUB_WORKER_STALLS  if set, worker never changes tasks.json (stagnation test)
  STUB_WORKER_STALLS_BY_APPROACH  comma-separated stall texts, one per
                      approach (task 026, #61 -- structural-wall signature)
  STUB_WORKER_WORK_FAULT  if set, every Worker invocation emits real
                      assistant text/tokens (produced traffic) then exits
                      1 with no verdict reported at all -- a deterministic
                      "work" fault classification (task 123, #60): unlike
                      STUB_INSTANT_FAIL_COUNT/STUB_WORKER_STALLS this never
                      trips the infra-retry wrapper or the stagnation
                      guard's infra/signal carve-out, so the assigned
                      task's pre-spawn in-progress claim is expected to
                      stay in-progress, never rolled back to pending.
  STUB_TOOL_SLEEP     seconds to sleep AFTER emitting `tool_execution_start`
                      but BEFORE emitting the matching `tool_execution_end`
                      inside `emit_rich_preamble` (default 0; only takes
                      effect when STUB_RICH_EVENTS is also set). Used by
                      task 004's black-box liveness test to open a real,
                      observable window in which a follow subprocess can
                      read the live invocation line off `ralphctl logs -f`
                      strictly before the tool call's completion event
                      exists at all.
  STUB_HUGE_LINE      if set, the first worker iteration emits one NDJSON line of
                      ~1 MiB (pi emits full message snapshots per event; the
                      engine must not choke on long lines)
  STUB_VERIFY_FAILS   number of verify invocations to fail before passing
                      (default 0; each failed invocation writes validation-failed
                      to tasks.json and does NOT emit the sentinel)
  STUB_VERIFY_MALFORMED_COUNT  task 033 (G.5, #130): how many of the FIRST
                      `Role: Verifier` invocations reply with NO parseable
                      `verify` contract payload at all (prose, no JSON) --
                      checked BEFORE STUB_VERIFY_ERRORS/STUB_VERIFY_FAILS,
                      its own `verify-call-count` marker index. Unlike
                      STUB_VERIFY_FAILS (a well-formed `rejected` verdict,
                      never touching the ladder), this trips the engine's
                      own uncharged re-ask ladder
                      (`contract_enforcement.enforce_contract` /
                      `_ask_contract_fix`) -- and since the re-ask prompt
                      carries no `Role: Verifier` marker, it falls to this
                      stub's own `else` branch below and is ALSO
                      unparseable, so the ladder exhausts naturally after
                      `1 + contract_retry_max` total stub invocations with
                      no extra stub logic needed to answer a re-ask.
  STUB_VERIFY_MALFORMED_FENCED  if set (together with
                      STUB_VERIFY_MALFORMED_COUNT), the malformed reply
                      above is prose followed by a fenced ```json block
                      that already carries a VALID `verify` payload --
                      task 032's fenced-payload rescue
                      (`_extract_validated_fenced_payload`) settles this on
                      the very first attempt with ZERO re-ask model calls,
                      never reaching the ladder's exhaustion path at all.
  STUB_REWRITE_CRITERIA  if set, a worker iteration that picks up a
                      validation-failed task rewrites its successCriteria
                      (appending " (rewritten by worker)") before marking it
                      completed again, instead of leaving the criteria text
                      untouched -- used by task 008's test to prove the
                      engine flags criteria edited after a validation
                      failure.
  STUB_VERIFY_ERRORS  number of verify invocations (from the start, before any
                      STUB_VERIFY_FAILS counting) that simulate a transient
                      agent/provider error instead of a real verdict: emits a
                      message_end with stopReason "error" and an errorMessage,
                      no sentinel, and does NOT touch tasks.json at all (task
                      050: infrastructure faults, e.g. a Bedrock 502, must
                      never be scored as a validation failure)
  STUB_RICH_EVENTS    if set, worker/reviewer/verifier iterations emit a
                      realistic pi NDJSON preamble before their final
                      message_end: a thinking content block (thinking_start/
                      thinking_delta/thinking_end), a tool call (toolcall_
                      start/delta/end plus top-level tool_execution_start/
                      tool_execution_end events), and the final assistant
                      text streamed as multiple text_start/text_delta/
                      text_end chunks. Shapes match real `pi --mode json`
                      output (see pi's docs/json.md and
                      docs/custom-provider.md "Event Types"/"Content Blocks").
  STUB_BAD_LINE       if set, emit exactly one malformed (non-JSON) line
                      during the first iteration that emits rich events, to
                      exercise malformed-line tolerance in log consumers.
  STUB_INSTANT_FAIL_COUNT  after the first STUB_INSTANT_FAIL_SKIP
                      invocations (default 0), the next N invocations of
                      the stub (any phase) exit nonzero immediately with
                      no NDJSON output at all, simulating a
                      provider/auth/infra startup fault such as missing
                      LLM credentials (task 059: proves the no-progress
                      escalation guard does not burn through approaches on
                      these before failing fast with a clear diagnostic
                      instead)
  STUB_INFRA_HANG_COUNT  after the first STUB_INFRA_HANG_SKIP invocations
                      (default 0), the next N invocations of the stub (any
                      phase) HANG -- sleep for a very long time producing
                      ZERO stdout/NDJSON output at all -- before eventually
                      exiting, simulating a transient LLM-endpoint/gateway
                      fault (e.g. a DNS glitch the process blocks on
                      internally) that never resolves on its own within any
                      reasonable time. Unlike STUB_INSTANT_FAIL_COUNT, this
                      does NOT exit quickly: the engine's own startup-window
                      watchdog (task 001a, RALPHD_INFRA_STARTUP_TIMEOUT)
                      must SIGINT the stub well before it would ever reach
                      the sleep's end, proving the engine fails fast on a
                      hang instead of waiting out the full iteration
                      timeout.
  STUB_INBAND_ERROR_COUNT  after the first STUB_INBAND_ERROR_SKIP
                      invocations (default 0), the next N invocations of
                      the stub (any phase) simulate the shape behind task
                      005 (#11): a provider/gateway outage pi surfaces
                      *in band* -- a single `message_end` with stopReason
                      "error", an infra-shaped `errorMessage`, ZERO token
                      usage and NO sentinel -- after which the process
                      shuts down cleanly and exits 0. Nothing else is
                      emitted and tasks.json is never touched. This is the
                      exit-0 failure the engine used to score as a success
                      (no retry, no refund, budget burned); the message
                      text defaults to pi's verbatim "Connection error."
                      and can be overridden with
                      STUB_INBAND_ERROR_MESSAGE.
  STUB_INBAND_ERROR_DELAY_S  seconds to sleep before emitting that in-band
                      error (default 0). A real gateway outage takes time
                      to surface; a test that wants the *retry* path rather
                      than the broken-environment instant-failure carve-out
                      (LoopSupervisor.INSTANT_FAILURE_MAX_DURATION_S = 5s)
                      must push the attempt's duration past that window.
  STUB_TIMEOUT_HANG_COUNT  after the first STUB_TIMEOUT_HANG_SKIP
                      invocations (default 0), the next N invocations of the
                      stub (any phase) emit ONE normal assistant message_end
                      -- real text and real token usage, so the engine has
                      observed genuine LLM traffic and its startup-window
                      watchdog is satisfied -- and then hang forever without
                      writing anything else. The only thing that can end such
                      an invocation is the engine's own FULL iteration timeout
                      (`iteration_timeout_s`), which is exactly the shape task
                      010 (#28) is about: the timeout must cost one failed
                      iteration, never the whole engine. Set
                      `iteration_timeout_s` in job.yaml to a couple of
                      seconds so the timeout fires quickly.
  STUB_TIMEOUT_HANG_SKIP  how many invocations behave normally before
                      STUB_TIMEOUT_HANG_COUNT starts (default 0).
  STUB_REFLECT_FAIL   make the `reflect` invocation (only) fail, whatever
                      invocation number it happens to be -- unlike the
                      globally-counted fault knobs above, so a test does not
                      have to know how many phases ran before reflect (task
                      019, #5). Two shapes:
                        `error`  an in-band provider/gateway error: a
                                 message_end with stopReason "error", an
                                 infra-shaped errorMessage (override with
                                 STUB_INBAND_ERROR_MESSAGE), zero token
                                 usage, exit 0, nothing written;
                        `silent` a clean exit 0 with an ordinary final
                                 message that writes NO
                                 artifacts/reflection/report.md -- the
                                 "phase ran, operator got no post-mortem"
                                 shape.
  STUB_ECHO_SECRET    comma-separated literal secret value(s) for the stub
                      worker to deliberately echo into its final assistant
                      text AND into a tool call's arguments/result (task
                      060: proves the engine's mechanical redaction catches
                      secrets an agent leaks this way, e.g. `cat`-ing a
                      cred file or `docker inspect`-ing a container's env).
                      A distinctive non-secret marker is always appended
                      alongside it so tests can prove ordinary text passes
                      through untouched.
  STUB_UNPRICED_COUNT  after the first STUB_UNPRICED_SKIP invocations
                      (default 0), the next N invocations (any phase) emit
                      their normal `message_end` with normal token counts but
                      NO `usage.cost` block at all -- the live shape behind
                      task 049 (#10), where a gateway bills tokens and
                      reports no pricing. Everything else about the
                      invocation is unchanged, so a run can mix priced and
                      unpriced iterations (use a large count for a fully
                      unpriced run).
  STUB_ZERO_COST_COUNT  like STUB_UNPRICED_COUNT (with its own
                      STUB_ZERO_COST_SKIP), but the selected invocations emit
                      normal token counts WITH `usage.cost = {"total": 0}` --
                      the live AIGW/Bedrock shape behind task 049 (v0.6,
                      steering 001): half a million billed tokens quoted at
                      exactly $0. Takes precedence over the unpriced knob for
                      an invocation selected by both.
  STUB_MODEL          the provider-side model id this stub claims to have
                      resolved, reported on every assistant `message_end` as
                      real pi does (`provider` + `model`, e.g. `amazon-bedrock`
                      + `eu.anthropic.claude-opus-5`). Defaults to whatever
                      `--model provider/id` the engine passed (split on the
                      first slash, mirroring pi's own ref form) and, when the
                      engine pinned nothing, to a stub default -- which is the
                      shape behind task 012 (#14): pi picks its own model and
                      only its message stream knows which.
  STUB_SIGNAL_ENGINE  if set, every worker iteration attacks its own supervisor
                      before doing any work: `pkill -f ralphd-engine`, then a
                      direct SIGTERM and SIGKILL to every pid whose
                      /proc/<pid>/cmdline mentions `ralphd-engine`. What each
                      attempt got (and the uid it was made from) is recorded in
                      `<run>/.stub-signal-engine.json` for the docker-tier test
                      of requirement I (#48) to read back: under the uid
                      boundary every attempt must be EPERM and the run must
                      finish normally.
  STUB_MODEL_PROVIDER the provider half of that pair, independently of
                      STUB_MODEL (which only sets the model half, so a ref
                      like `stubby/stub-model-1` stays one string). Together
                      they let an UNPINNED run report a real gateway-shaped
                      pair -- `amazon-bedrock` + `eu.anthropic.claude-opus-5`
                      with no `--model` on the command line -- the route task
                      050 (#14) prices from the observed id.

Every invocation unconditionally records the exact prompt it received to
`<run>/.stub-last-prompt` (overwritten) and appends it to
`<run>/.stub-all-prompts` (delimited by `===PROMPT===`), for tests that need
to inspect job-context content across phases/iterations.
"""
import json
import os
import sys
import time

prompt = sys.stdin.read()
run = os.environ["STUB_RUN_DIR"]
tasks_file = os.path.join(run, "tasks.json")

# Task 020: the vigilant mini-FSM's terminal (`validated`) is as "done" as
# the non-vigilant terminal (`completed`) for every purpose the stub itself
# decides on -- picking a dependency as satisfied, and deciding whether the
# whole plan is finished and COMPLETE is honestly earned. Mirrors
# `engine.state.TASK_COMPLETION_STATUSES` without importing the engine (the
# stub is a black-box double, task 052's rule -- fact 3).
_TASK_SATISFIES_DEPENDENCY = ("completed", "validated")
_PLAN_FULLY_RESOLVED_STATUSES = _TASK_SATISFIES_DEPENDENCY + ("skipped",)

# The model this invocation reports having used, pi-style: a `provider` plus a
# provider-side `model` id on every assistant message_end (task 012, #14).
# `--model provider/id` from the engine is the default; STUB_MODEL overrides
# the provider-side half; with neither, a stub default stands in for "pi chose
# its own model" -- the case where run state can only learn the id from here.
def _resolve_model():
    ref = None
    argv = sys.argv[1:]
    for i, arg in enumerate(argv):
        if arg == "--model" and i + 1 < len(argv):
            ref = argv[i + 1]
        elif arg.startswith("--model="):
            ref = arg.split("=", 1)[1]
    provider, model = "stub-provider", "stub-model-1"
    if ref:
        provider, _, rest = ref.partition("/")
        model = rest or provider
        if not rest:
            provider = ""
    if os.environ.get("STUB_MODEL"):
        model = os.environ["STUB_MODEL"]
    if os.environ.get("STUB_MODEL_PROVIDER"):
        provider = os.environ["STUB_MODEL_PROVIDER"]
    return provider, model


MODEL_PROVIDER, MODEL_ID = _resolve_model()
# Worker iterations sleep *after* writing in-progress (see below) so tests
# can poll for the pending -> in-progress transition while the iteration is
# still "running" from the engine's point of view; every other phase keeps
# the original top-of-invocation sleep.
if "Role: Worker" not in prompt:
    time.sleep(float(os.environ.get("STUB_SLEEP", "0")))


def marker(name):
    return os.path.join(run, f".stub-{name}")


def _declare_worker_petition():
    """STUB_WORKER_PETITION's declaration, or None (task 005, G.5).

    Exactly one declaration per run (its own marker file): an obligation may
    carry at most one petition for the life of a run, so a second filing of
    the same one is a duplicate the engine refuses rather than files.
    Creates the wave's `<wave>-petitions.md` under the workspace's
    `artifacts/reports/` when the workspace carries none -- the pre-created
    file a real wave's planning phase places, and the only thing
    `petitions.file_worker_petition` will file into. cwd is the workspace
    for every real `pi` iteration (`runner.py` passes it), so this writes
    where a worker's own edits go, never into the run dir.
    """
    raw = os.environ.get("STUB_WORKER_PETITION")
    if not raw:
        return None
    declared = marker("worker-petition-declared")
    if os.path.exists(declared):
        return None
    reports = os.path.join(os.getcwd(), "artifacts", "reports")
    os.makedirs(reports, exist_ok=True)
    wave = os.environ.get("STUB_PETITIONS_WAVE", "v0.0")
    petitions_file = os.path.join(reports, f"{wave}-petitions.md")
    if not os.path.exists(petitions_file):
        with open(petitions_file, "w") as f:
            f.write(f"# {wave} impossibility petitions\n\n"
                    "Filed per docs/petition-format.md.\n\n")
    with open(declared, "w") as f:
        f.write("1")
    return json.loads(raw)


def _review_adjudications():
    """STUB_REVIEW_ADJUDICATIONS' entries for a verifying review reply's
    `petition_adjudications` field, or None when the knob is unset (task
    005, G.5)."""
    raw = os.environ.get("STUB_REVIEW_ADJUDICATIONS")
    return json.loads(raw) if raw else None


# STUB_INSTANT_FAIL_COUNT simulates a provider/auth/infra startup fault
# (e.g. no LLM credentials): after the first STUB_INSTANT_FAIL_SKIP
# invocations behave normally (default 0), the next N invocations of the
# stub, across ANY phase, exit nonzero immediately without emitting a
# single valid pi NDJSON event -- mirroring the real incident behind task
# 059 where pi errored out before doing any observable work at all.
# Counted globally (all phases share the marker) since a real credential
# failure would happen on process start regardless of which phase invoked
# it.
_instant_fail_count = int(os.environ.get("STUB_INSTANT_FAIL_COUNT", "0"))
