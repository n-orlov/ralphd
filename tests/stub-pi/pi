#!/usr/bin/env python3
"""Stub `pi` for black-box engine tests.

Reads the phase prompt on stdin, emits pi-shaped NDJSON on stdout, and mutates
run-dir state files the way a real agent iteration would. Scenario knobs come
from env vars set by the test:

  STUB_RUN_DIR        run dir (required)
  STUB_TASKS          number of tasks the planner creates (default 2)
  STUB_REVIEW_FAILS   how many reviews reject before verifying (default 0)
  STUB_WORKER_STALLS  if set, worker never changes tasks.json (stagnation test)
  STUB_TOOL_SLEEP     seconds to sleep AFTER emitting `tool_execution_start`
                      but BEFORE emitting the matching `tool_execution_end`
                      inside `emit_rich_preamble` (default 0; only takes
                      effect when STUB_RICH_EVENTS is also set). Used by
                      task 004's black-box liveness test to open a real,
                      observable window in which a follow subprocess can
                      read the live invocation line off `ralphctl logs -f`
                      strictly before the tool call's completion event
                      exists at all.
  STUB_HUGE_LINE      if set, the first worker iteration emits one NDJSON line of
                      ~1 MiB (pi emits full message snapshots per event; the
                      engine must not choke on long lines)
  STUB_VERIFY_FAILS   number of verify invocations to fail before passing
                      (default 0; each failed invocation writes validation-failed
                      to tasks.json and does NOT emit the sentinel)
  STUB_REWRITE_CRITERIA  if set, a worker iteration that picks up a
                      validation-failed task rewrites its successCriteria
                      (appending " (rewritten by worker)") before marking it
                      completed again, instead of leaving the criteria text
                      untouched -- used by task 008's test to prove the
                      engine flags criteria edited after a validation
                      failure.
  STUB_VERIFY_ERRORS  number of verify invocations (from the start, before any
                      STUB_VERIFY_FAILS counting) that simulate a transient
                      agent/provider error instead of a real verdict: emits a
                      message_end with stopReason "error" and an errorMessage,
                      no sentinel, and does NOT touch tasks.json at all (task
                      050: infrastructure faults, e.g. a Bedrock 502, must
                      never be scored as a validation failure)
  STUB_RICH_EVENTS    if set, worker/reviewer/verifier iterations emit a
                      realistic pi NDJSON preamble before their final
                      message_end: a thinking content block (thinking_start/
                      thinking_delta/thinking_end), a tool call (toolcall_
                      start/delta/end plus top-level tool_execution_start/
                      tool_execution_end events), and the final assistant
                      text streamed as multiple text_start/text_delta/
                      text_end chunks. Shapes match real `pi --mode json`
                      output (see pi's docs/json.md and
                      docs/custom-provider.md "Event Types"/"Content Blocks").
  STUB_BAD_LINE       if set, emit exactly one malformed (non-JSON) line
                      during the first iteration that emits rich events, to
                      exercise malformed-line tolerance in log consumers.
  STUB_INSTANT_FAIL_COUNT  after the first STUB_INSTANT_FAIL_SKIP
                      invocations (default 0), the next N invocations of
                      the stub (any phase) exit nonzero immediately with
                      no NDJSON output at all, simulating a
                      provider/auth/infra startup fault such as missing
                      LLM credentials (task 059: proves the no-progress
                      escalation guard does not burn through approaches on
                      these before failing fast with a clear diagnostic
                      instead)
  STUB_INFRA_HANG_COUNT  after the first STUB_INFRA_HANG_SKIP invocations
                      (default 0), the next N invocations of the stub (any
                      phase) HANG -- sleep for a very long time producing
                      ZERO stdout/NDJSON output at all -- before eventually
                      exiting, simulating a transient LLM-endpoint/gateway
                      fault (e.g. a DNS glitch the process blocks on
                      internally) that never resolves on its own within any
                      reasonable time. Unlike STUB_INSTANT_FAIL_COUNT, this
                      does NOT exit quickly: the engine's own startup-window
                      watchdog (task 001a, RALPHD_INFRA_STARTUP_TIMEOUT)
                      must SIGINT the stub well before it would ever reach
                      the sleep's end, proving the engine fails fast on a
                      hang instead of waiting out the full iteration
                      timeout.
  STUB_INBAND_ERROR_COUNT  after the first STUB_INBAND_ERROR_SKIP
                      invocations (default 0), the next N invocations of
                      the stub (any phase) simulate the shape behind task
                      005 (#11): a provider/gateway outage pi surfaces
                      *in band* -- a single `message_end` with stopReason
                      "error", an infra-shaped `errorMessage`, ZERO token
                      usage and NO sentinel -- after which the process
                      shuts down cleanly and exits 0. Nothing else is
                      emitted and tasks.json is never touched. This is the
                      exit-0 failure the engine used to score as a success
                      (no retry, no refund, budget burned); the message
                      text defaults to pi's verbatim "Connection error."
                      and can be overridden with
                      STUB_INBAND_ERROR_MESSAGE.
  STUB_INBAND_ERROR_DELAY_S  seconds to sleep before emitting that in-band
                      error (default 0). A real gateway outage takes time
                      to surface; a test that wants the *retry* path rather
                      than the broken-environment instant-failure carve-out
                      (LoopSupervisor.INSTANT_FAILURE_MAX_DURATION_S = 5s)
                      must push the attempt's duration past that window.
  STUB_REFLECT_FAIL   make the `reflect` invocation (only) fail, whatever
                      invocation number it happens to be -- unlike the
                      globally-counted fault knobs above, so a test does not
                      have to know how many phases ran before reflect (task
                      019, #5). Two shapes:
                        `error`  an in-band provider/gateway error: a
                                 message_end with stopReason "error", an
                                 infra-shaped errorMessage (override with
                                 STUB_INBAND_ERROR_MESSAGE), zero token
                                 usage, exit 0, nothing written;
                        `silent` a clean exit 0 with an ordinary final
                                 message that writes NO
                                 artifacts/reflection/report.md -- the
                                 "phase ran, operator got no post-mortem"
                                 shape.
  STUB_ECHO_SECRET    comma-separated literal secret value(s) for the stub
                      worker to deliberately echo into its final assistant
                      text AND into a tool call's arguments/result (task
                      060: proves the engine's mechanical redaction catches
                      secrets an agent leaks this way, e.g. `cat`-ing a
                      cred file or `docker inspect`-ing a container's env).
                      A distinctive non-secret marker is always appended
                      alongside it so tests can prove ordinary text passes
                      through untouched.
  STUB_UNPRICED_COUNT  after the first STUB_UNPRICED_SKIP invocations
                      (default 0), the next N invocations (any phase) emit
                      their normal `message_end` with normal token counts but
                      NO `usage.cost` block at all -- the live shape behind
                      task 049 (#10), where a gateway bills tokens and
                      reports no pricing. Everything else about the
                      invocation is unchanged, so a run can mix priced and
                      unpriced iterations (use a large count for a fully
                      unpriced run).
  STUB_ZERO_COST_COUNT  like STUB_UNPRICED_COUNT (with its own
                      STUB_ZERO_COST_SKIP), but the selected invocations emit
                      normal token counts WITH `usage.cost = {"total": 0}` --
                      the live AIGW/Bedrock shape behind task 049 (v0.6,
                      steering 001): half a million billed tokens quoted at
                      exactly $0. Takes precedence over the unpriced knob for
                      an invocation selected by both.
  STUB_MODEL          the provider-side model id this stub claims to have
                      resolved, reported on every assistant `message_end` as
                      real pi does (`provider` + `model`, e.g. `amazon-bedrock`
                      + `eu.anthropic.claude-opus-5`). Defaults to whatever
                      `--model provider/id` the engine passed (split on the
                      first slash, mirroring pi's own ref form) and, when the
                      engine pinned nothing, to a stub default -- which is the
                      shape behind task 012 (#14): pi picks its own model and
                      only its message stream knows which.
  STUB_MODEL_PROVIDER the provider half of that pair, independently of
                      STUB_MODEL (which only sets the model half, so a ref
                      like `stubby/stub-model-1` stays one string). Together
                      they let an UNPINNED run report a real gateway-shaped
                      pair -- `amazon-bedrock` + `eu.anthropic.claude-opus-5`
                      with no `--model` on the command line -- the route task
                      050 (#14) prices from the observed id.

Every invocation unconditionally records the exact prompt it received to
`<run>/.stub-last-prompt` (overwritten) and appends it to
`<run>/.stub-all-prompts` (delimited by `===PROMPT===`), for tests that need
to inspect job-context content across phases/iterations.
"""
import json
import os
import sys
import time

prompt = sys.stdin.read()
run = os.environ["STUB_RUN_DIR"]
tasks_file = os.path.join(run, "tasks.json")

# The model this invocation reports having used, pi-style: a `provider` plus a
# provider-side `model` id on every assistant message_end (task 012, #14).
# `--model provider/id` from the engine is the default; STUB_MODEL overrides
# the provider-side half; with neither, a stub default stands in for "pi chose
# its own model" -- the case where run state can only learn the id from here.
def _resolve_model():
    ref = None
    argv = sys.argv[1:]
    for i, arg in enumerate(argv):
        if arg == "--model" and i + 1 < len(argv):
            ref = argv[i + 1]
        elif arg.startswith("--model="):
            ref = arg.split("=", 1)[1]
    provider, model = "stub-provider", "stub-model-1"
    if ref:
        provider, _, rest = ref.partition("/")
        model = rest or provider
        if not rest:
            provider = ""
    if os.environ.get("STUB_MODEL"):
        model = os.environ["STUB_MODEL"]
    if os.environ.get("STUB_MODEL_PROVIDER"):
        provider = os.environ["STUB_MODEL_PROVIDER"]
    return provider, model


MODEL_PROVIDER, MODEL_ID = _resolve_model()
# Worker iterations sleep *after* writing in-progress (see below) so tests
# can poll for the pending -> in-progress transition while the iteration is
# still "running" from the engine's point of view; every other phase keeps
# the original top-of-invocation sleep.
if "Role: Worker" not in prompt:
    time.sleep(float(os.environ.get("STUB_SLEEP", "0")))


def marker(name):
    return os.path.join(run, f".stub-{name}")


# STUB_INSTANT_FAIL_COUNT simulates a provider/auth/infra startup fault
# (e.g. no LLM credentials): after the first STUB_INSTANT_FAIL_SKIP
# invocations behave normally (default 0), the next N invocations of the
# stub, across ANY phase, exit nonzero immediately without emitting a
# single valid pi NDJSON event -- mirroring the real incident behind task
# 059 where pi errored out before doing any observable work at all.
# Counted globally (all phases share the marker) since a real credential
# failure would happen on process start regardless of which phase invoked
# it.
_instant_fail_count = int(os.environ.get("STUB_INSTANT_FAIL_COUNT", "0"))
_instant_fail_skip = int(os.environ.get("STUB_INSTANT_FAIL_SKIP", "0"))
if _instant_fail_count:
    _fail_marker = marker("instant-fail-count")
    _seen = 0
    if os.path.exists(_fail_marker):
        _seen = int(open(_fail_marker).read())
    with open(_fail_marker, "w") as _f:
        _f.write(str(_seen + 1))
    if _instant_fail_skip <= _seen < _instant_fail_skip + _instant_fail_count:
        sys.stderr.write("stub: simulated instant startup failure (no LLM credentials)\n")
        sys.exit(1)


# STUB_UNPRICED_COUNT (task 049, #10): make the selected invocations report
# token usage with no `cost` block -- the observed gateway shape where
# tokens are billed but no price is quoted. Counted globally across phases
# like the other knobs; only emit_final()'s usage block is affected.
_unpriced_count = int(os.environ.get("STUB_UNPRICED_COUNT", "0"))
_unpriced_skip = int(os.environ.get("STUB_UNPRICED_SKIP", "0"))
UNPRICED_NOW = False
if _unpriced_count:
    _unpriced_marker = marker("unpriced-count")
    _seen = 0
    if os.path.exists(_unpriced_marker):
        _seen = int(open(_unpriced_marker).read())
    with open(_unpriced_marker, "w") as _f:
        _f.write(str(_seen + 1))
    UNPRICED_NOW = _unpriced_skip <= _seen < _unpriced_skip + _unpriced_count

# STUB_ZERO_COST_COUNT (task 049, v0.6): the implausible-zero shape -- tokens
# billed AND a cost block quoting exactly 0. Same counting discipline as the
# unpriced knob, its own marker file so the two can be combined.
_zero_cost_count = int(os.environ.get("STUB_ZERO_COST_COUNT", "0"))
_zero_cost_skip = int(os.environ.get("STUB_ZERO_COST_SKIP", "0"))
ZERO_COST_NOW = False
if _zero_cost_count:
    _zero_marker = marker("zero-cost-count")
    _zseen = 0
    if os.path.exists(_zero_marker):
        _zseen = int(open(_zero_marker).read())
    with open(_zero_marker, "w") as _f:
        _f.write(str(_zseen + 1))
    ZERO_COST_NOW = _zero_cost_skip <= _zseen < _zero_cost_skip + _zero_cost_count


# STUB_INFRA_HANG_COUNT simulates a transient LLM-endpoint/gateway fault
# (task 001a's live incident: a "getaddrinfo ENOTFOUND" DNS glitch that hung
# the *entire* 45-minute iteration timeout before finally dying) -- after
# the first STUB_INFRA_HANG_SKIP invocations behave normally (default 0),
# the next N invocations of the stub, across ANY phase, sleep for a very
# long time producing ZERO stdout output before this process would ever
# print a single byte. The engine's own startup-window watchdog is what's
# supposed to SIGINT this well before the sleep ever completes; if it
# didn't, this stub would otherwise hang for the full test timeout too.
_infra_hang_count = int(os.environ.get("STUB_INFRA_HANG_COUNT", "0"))
_infra_hang_skip = int(os.environ.get("STUB_INFRA_HANG_SKIP", "0"))
if _infra_hang_count:
    _hang_marker = marker("infra-hang-count")
    _seen = 0
    if os.path.exists(_hang_marker):
        _seen = int(open(_hang_marker).read())
    with open(_hang_marker, "w") as _f:
        _f.write(str(_seen + 1))
    if _infra_hang_skip <= _seen < _infra_hang_skip + _infra_hang_count:
        sys.stderr.write("stub: simulated infra hang (zero LLM traffic)\n")
        sys.stderr.flush()
        time.sleep(9999)
        sys.exit(1)


# Always record the full prompt this invocation received (never gated by a
# knob -- tests inspect this to prove job-context content such as the creds
# inventory reaches every phase, with no dependency on stub-only behaviour).
with open(marker("last-prompt"), "w") as _f:
    _f.write(prompt)
with open(marker("all-prompts"), "a") as _f:
    _f.write("\n===PROMPT===\n")
    _f.write(prompt)

# Likewise, always record the skill *names* currently visible under
# ~/.pi/agent/skills (never contents) -- black-box proof that runtime
# skills CRUD (PUT/DELETE /config/skills/{name}) is visible to the very
# next iteration without a container restart.
_skills_dir = os.path.join(os.environ.get("HOME", os.path.expanduser("~")),
                           ".pi", "agent", "skills")
with open(marker("skills"), "w") as _f:
    if os.path.isdir(_skills_dir):
        _f.write("\n".join(sorted(os.listdir(_skills_dir))))

# Always dump this invocation's full environment (names AND values) to a
# JSON marker -- black-box proof that runtime LLM env rotation (PUT
# /config/llm) reaches the very next `pi` subprocess without a container
# restart. Overwritten every invocation, never gated by a knob.
with open(marker("env.json"), "w") as _f:
    json.dump(dict(os.environ), _f)


# STUB_INBAND_ERROR_COUNT simulates a transient provider/gateway fault that
# pi reports *in band* instead of by dying: a message_end with stopReason
# "error", an infra-shaped errorMessage, zero token usage, no sentinel --
# and then a clean exit 0 (the live shape behind tasks 001/005, #11, where
# the iteration burned budget because exit 0 alone was read as success).
# Counted globally across phases like the other fault knobs, and gated by
# STUB_INBAND_ERROR_SKIP so a test can let planning through first.
_inband_count = int(os.environ.get("STUB_INBAND_ERROR_COUNT", "0"))
_inband_skip = int(os.environ.get("STUB_INBAND_ERROR_SKIP", "0"))
if _inband_count:
    _inband_marker = marker("inband-error-count")
    _seen = 0
    if os.path.exists(_inband_marker):
        _seen = int(open(_inband_marker).read())
    with open(_inband_marker, "w") as _f:
        _f.write(str(_seen + 1))
    if _inband_skip <= _seen < _inband_skip + _inband_count:
        # An outage takes time to surface; the delay keeps this out of the
        # engine's instant-failure (broken-environment) carve-out so the
        # retry path is what the test exercises.
        time.sleep(float(os.environ.get("STUB_INBAND_ERROR_DELAY_S", "0")))
        print(json.dumps({
            "type": "message_end",
            "message": {
                "role": "assistant",
                "stopReason": "error",
                "errorMessage": os.environ.get(
                    "STUB_INBAND_ERROR_MESSAGE", "Connection error."),
                "content": [],
                "usage": {"input": 0, "output": 0, "totalTokens": 0},
            },
        }))
        sys.exit(0)


def _chunks(s, n=6):
    """Split s into ~n pieces, for delta-style streaming."""
    if not s:
        return [s]
    size = max(1, len(s) // n)
    return [s[i:i + size] for i in range(0, len(s), size)]


def emit_rich_preamble(tool_name="bash", tool_args=None, thinking_text=None,
                        tool_result="ok"):
    """Emit a realistic pi `--mode json` event sequence: a streamed thinking
    content block, a streamed tool call (with matching top-level
    tool_execution_* events), and -- once per run, if STUB_BAD_LINE is set --
    one malformed line. Returns the (toolCall, thinking_text) content blocks
    for the caller to fold into its authoritative message_end.
    """
    thinking_text = thinking_text or "Considering the best approach to this task."
    tool_args = tool_args if tool_args is not None else {"command": "ls -la"}

    print(json.dumps({"type": "message_update", "assistantMessageEvent":
                       {"type": "thinking_start", "contentIndex": 0}}))
    for piece in _chunks(thinking_text):
        print(json.dumps({"type": "message_update", "assistantMessageEvent":
                           {"type": "thinking_delta", "contentIndex": 0, "delta": piece}}))
    print(json.dumps({"type": "message_update", "assistantMessageEvent":
                       {"type": "thinking_end", "contentIndex": 0, "content": thinking_text}}))

    if os.environ.get("STUB_BAD_LINE") and not os.path.exists(marker("bad-line-sent")):
        open(marker("bad-line-sent"), "w").write("1")
        print("not json at all -- malformed line for tolerance testing")

    tool_call_id = "call_0001"
    args_json = json.dumps(tool_args)
    print(json.dumps({"type": "message_update", "assistantMessageEvent":
                       {"type": "toolcall_start", "contentIndex": 1}}))
    for piece in _chunks(args_json):
        print(json.dumps({"type": "message_update", "assistantMessageEvent":
                           {"type": "toolcall_delta", "contentIndex": 1, "delta": piece}}))
    tool_call = {"type": "toolCall", "id": tool_call_id, "name": tool_name, "arguments": tool_args}
    print(json.dumps({"type": "message_update", "assistantMessageEvent":
                       {"type": "toolcall_end", "contentIndex": 1, "toolCall": tool_call}}))
    print(json.dumps({"type": "tool_execution_start", "toolCallId": tool_call_id,
                       "toolName": tool_name, "args": tool_args}))
    sys.stdout.flush()
    _tool_sleep = float(os.environ.get("STUB_TOOL_SLEEP", "0"))
    if _tool_sleep:
        time.sleep(_tool_sleep)
    print(json.dumps({"type": "tool_execution_end", "toolCallId": tool_call_id,
                       "toolName": tool_name, "result": tool_result, "isError": False}))
    return tool_call, thinking_text


def emit_final(text, tool_call=None, thinking_text=None):
    rich = os.environ.get("STUB_RICH_EVENTS")
    if rich:
        # Stream the final assistant text as multiple text_start/delta/end
        # chunks (matching real pi json-mode message_update events) before
        # the authoritative message_end snapshot.
        print(json.dumps({"type": "message_update", "assistantMessageEvent":
                           {"type": "text_start", "contentIndex": 2}}))
        for piece in _chunks(text):
            print(json.dumps({"type": "message_update", "assistantMessageEvent":
                               {"type": "text_delta", "contentIndex": 2, "delta": piece}}))
        print(json.dumps({"type": "message_update", "assistantMessageEvent":
                           {"type": "text_end", "contentIndex": 2, "content": text}}))
    content = []
    if thinking_text is not None:
        content.append({"type": "thinking", "thinking": thinking_text})
    if tool_call is not None:
        content.append(tool_call)
    content.append({"type": "text", "text": text})
    _usage = {"input": 100, "output": 10, "totalTokens": 110}
    if ZERO_COST_NOW:
        _usage["cost"] = {"total": 0}
    elif not UNPRICED_NOW:
        _usage["cost"] = {"total": 0.01}
    _message = {
        "role": "assistant",
        "content": content,
        "usage": _usage,
    }
    if MODEL_PROVIDER:
        _message["provider"] = MODEL_PROVIDER
    if MODEL_ID:
        _message["model"] = MODEL_ID
    print(json.dumps({
        "type": "message_end",
        "message": _message,
    }))


if "Role: Planner" in prompt:
    # STUB_TASKS_JSON lets a test hand the planner an exact tasks list
    # (including optional dependsOn/priority fields) instead of the plain
    # auto-numbered STUB_TASKS sequence -- needed for deterministic
    # scheduler-ordering tests (task 048).
    override = os.environ.get("STUB_TASKS_JSON")
    if override:
        tasks = json.loads(override)
    else:
        n = int(os.environ.get("STUB_TASKS", "2"))
        tasks = [{"id": f"{i:03d}", "title": f"task {i}", "status": "pending",
                  "successCriteria": f"criteria {i}"} for i in range(1, n + 1)]
    with open(tasks_file, "w") as f:
        json.dump({"version": 1, "goal": "stub goal", "tasks": tasks}, f)
    with open(os.path.join(run, "notes.md"), "w") as f:
        f.write("planned by stub\n")
    emit_final("planning done")

elif "Role: Worker" in prompt:
    if os.environ.get("STUB_HUGE_LINE") and not os.path.exists(marker("huge-sent")):
        open(marker("huge-sent"), "w").write("1")
        print(json.dumps({"type": "message_update", "padding": "x" * (1024 * 1024)}))
    if os.environ.get("STUB_WORKER_STALLS"):
        emit_final("spinning wheels, no progress")
        sys.exit(0)
    tool_call = thinking_text = None
    echo_secrets = [s for s in os.environ.get("STUB_ECHO_SECRET", "").split(",") if s]
    if echo_secrets:
        # Deliberately leak the planted secret value(s) into a tool call's
        # arguments AND its result -- mirrors the two real incidents behind
        # task 060 (cat-ing a cred file's contents; `docker inspect` dumping
        # a container's env), so the black-box test can prove the engine's
        # mechanical redaction catches this regardless of *how* an agent
        # leaks a known secret value.
        tool_call, thinking_text = emit_rich_preamble(
            tool_name="bash",
            tool_args={"command": "echo " + " ".join(echo_secrets)},
            thinking_text="Echoing configuration for debugging.",
            tool_result="\n".join(echo_secrets))
    elif os.environ.get("STUB_RICH_EVENTS"):
        tool_call, thinking_text = emit_rich_preamble(
            tool_name="bash", tool_args={"command": "python -m pytest tests/ -q"},
            thinking_text="Picking the next pending task and making it pass.")
    with open(tasks_file) as f:
        d = json.load(f)
    tasks = d["tasks"]
    # Pick validation-failed first, then in-progress, then apply the
    # dependsOn/priority-aware scheduler to pending tasks (mirrors
    # worker.md's documented pick rule -- see task 048). With no
    # dependsOn/priority fields anywhere in the plan this degenerates to
    # plain list order (today's behaviour, unchanged).
    validation_failed = [t for t in tasks if t["status"] == "validation-failed"]
    in_progress = [t for t in tasks if t["status"] == "in-progress"]
    picked = None
    if validation_failed:
        picked = validation_failed[0]
    elif in_progress:
        picked = in_progress[0]
    else:
        status_by_id = {t["id"]: t["status"] for t in tasks}
        candidates = []
        blocked_notes = []
        for t in tasks:
            if t["status"] != "pending":
                continue
            deps = t.get("dependsOn") or []
            unmet = [dep for dep in deps if status_by_id.get(dep) != "completed"]
            if unmet:
                dead = [dep for dep in unmet if status_by_id.get(dep) in ("failed", "skipped")]
                if dead:
                    blocked_notes.append(
                        f"task {t['id']} blocked: dependency "
                        f"{','.join(dead)} failed/skipped, not completed")
                continue
            candidates.append(t)
        if candidates:
            # highest priority wins (missing = 0); ties broken by list order
            best_priority = max(c.get("priority", 0) for c in candidates)
            for c in candidates:
                if c.get("priority", 0) == best_priority:
                    picked = c
                    break
        if blocked_notes:
            with open(os.path.join(run, "notes.md"), "a") as f:
                f.write("\n" + "\n".join(blocked_notes) + "\n")
    if picked is not None:
        if os.environ.get("STUB_REWRITE_CRITERIA") and picked["status"] == "validation-failed":
            picked["successCriteria"] = (
                picked.get("successCriteria", "") + " (rewritten by worker)")
        # Mandatory first write of the iteration (mirrors worker.md's rule):
        # flip the picked task to in-progress and persist it *before* doing
        # any "work", then sleep to simulate work time -- this is the window
        # in which an operator/black-box test can observe the task as
        # in-progress while the iteration is still running.
        picked["status"] = "in-progress"
        with open(tasks_file, "w") as f:
            json.dump(d, f)
        time.sleep(float(os.environ.get("STUB_SLEEP", "0")))
        picked["status"] = "completed"
        with open(tasks_file, "w") as f:
            json.dump(d, f)
    # record steering whenever a worker iteration sees it
    if "Operator steering" in prompt:
        with open(marker("saw-steering"), "a") as f:
            f.write(prompt[prompt.index("Operator steering"):][:2000])
    if all(t["status"] == "completed" for t in d["tasks"]):
        text = "everything finished"
        if echo_secrets:
            text += " secrets: " + " ".join(echo_secrets) + " NONSECRET_SENTINEL_9f3a"
        text += "\n<promise>COMPLETE</promise>"
        emit_final(text, tool_call=tool_call, thinking_text=thinking_text)
    else:
        text = "completed one task"
        if echo_secrets:
            text += " secrets: " + " ".join(echo_secrets) + " NONSECRET_SENTINEL_9f3a"
        emit_final(text, tool_call=tool_call, thinking_text=thinking_text)

elif "Role: Reviewer" in prompt:
    fails_wanted = int(os.environ.get("STUB_REVIEW_FAILS", "0"))
    done = 0
    if os.path.exists(marker("review-count")):
        done = int(open(marker("review-count")).read())
    open(marker("review-count"), "w").write(str(done + 1))
    tool_call = thinking_text = None
    if os.environ.get("STUB_RICH_EVENTS"):
        tool_call, thinking_text = emit_rich_preamble(
            tool_name="bash", tool_args={"command": "git diff --stat"},
            thinking_text="Checking whether the reviewed requirements are met.")
    if done < fails_wanted:
        with open(os.path.join(run, "review-findings.md"), "w") as f:
            f.write(f"- finding from review #{done + 1}\n")
        emit_final("requirements unmet", tool_call=tool_call, thinking_text=thinking_text)
    else:
        emit_final("all requirements hold\n<promise>VERIFIED</promise>",
                    tool_call=tool_call, thinking_text=thinking_text)

elif "Role: Verifier" in prompt:
    # Extract task id from the injected section: "- **id**: XXX"
    task_id = None
    for line in prompt.splitlines():
        line = line.strip()
        if line.startswith("- **id**:"):
            task_id = line.split(":", 1)[1].strip()
            break

    call_marker = marker("verify-call-count")
    call_n = 0
    if os.path.exists(call_marker):
        call_n = int(open(call_marker).read())
    open(call_marker, "w").write(str(call_n + 1))

    errors_wanted = int(os.environ.get("STUB_VERIFY_ERRORS", "0"))
    if call_n < errors_wanted:
        # Simulate a transient agent/provider error (e.g. Bedrock 502) mid-
        # verify: a message_end with stopReason "error", no sentinel, and no
        # tasks.json mutation at all -- proves the engine must not score
        # this as a validation failure (task 050).
        print(json.dumps({
            "type": "message_end",
            "message": {
                "role": "assistant",
                "stopReason": "error",
                "errorMessage": "stub: transient provider error (bedrock 502)",
                "content": [],
                "usage": {"input": 10, "output": 0, "totalTokens": 10},
            },
        }))
        sys.exit(0)

    fails_wanted = int(os.environ.get("STUB_VERIFY_FAILS", "0"))
    done = call_n - errors_wanted

    if done < fails_wanted:
        # Write validation-failed into tasks.json
        with open(tasks_file) as f:
            d = json.load(f)
        for t in d["tasks"]:
            if t["id"] == task_id:
                t["status"] = "validation-failed"
                t["validationNotes"] = (
                    f"stub: deliberate failure #{done + 1} for task {task_id}"
                )
                break
        with open(tasks_file, "w") as f:
            json.dump(d, f)
        emit_final(f"stub verifier: failing task {task_id} (attempt {done + 1})")
    else:
        emit_final(
            f"stub verifier: task {task_id} looks good\n"
            f"<task-verified>{task_id}</task-verified>"
        )

elif "Role: Reflector" in prompt:
    # Task 019 (#5): a reflect-only failure knob. The engine must notice that
    # the post-mortem never got written -- both when the agent errors out and
    # when it exits 0 having written nothing at all.
    _reflect_fail = os.environ.get("STUB_REFLECT_FAIL", "")
    if _reflect_fail == "error":
        print(json.dumps({
            "type": "message_end",
            "message": {
                "role": "assistant",
                "stopReason": "error",
                "errorMessage": os.environ.get(
                    "STUB_INBAND_ERROR_MESSAGE", "Connection error."),
                "content": [],
                "usage": {"input": 0, "output": 0, "totalTokens": 0},
            },
        }))
        sys.exit(0)
    if _reflect_fail == "silent":
        emit_final("stub reflector: wrote nothing at all")
        sys.exit(0)
    # Post-job self-reflection: writes a report + a unified diff to
    # artifacts/reflection/, never touching workspace or run state (tasks.json,
    # status.json, notes.md, review-findings.md are left alone).
    reflection_dir = os.path.join(run, "artifacts", "reflection")
    os.makedirs(reflection_dir, exist_ok=True)
    with open(os.path.join(reflection_dir, "report.md"), "w") as f:
        f.write(
            "# Reflection report\n\n"
            "Stub self-reflection: no workspace or run-state files were "
            "modified by this phase.\n"
        )
    with open(os.path.join(reflection_dir, "suggestions.diff"), "w") as f:
        f.write(
            "--- a/src/ralphd/prompts/worker.md\n"
            "+++ b/src/ralphd/prompts/worker.md\n"
            "@@ -1,1 +1,1 @@\n"
            "-# Role: Worker\n"
            "+# Role: Worker (stub-suggested tweak, not applied)\n"
        )
    tool_call = thinking_text = None
    if os.environ.get("STUB_RICH_EVENTS"):
        tool_call, thinking_text = emit_rich_preamble(
            tool_name="write", tool_args={"path": "artifacts/reflection/report.md"},
            thinking_text="Summarizing what worked and what could improve next run.")
    emit_final("reflection complete\n<promise>REFLECTED</promise>",
                tool_call=tool_call, thinking_text=thinking_text)

else:
    emit_final("unrecognized phase prompt")
