# from exactly where it happened for real -- inside a worker iteration. Tries
# the pattern kill the PRD cites (`pkill -f ralphd-engine`) and then, so the
# test does not depend on procps being present or on pkill's own matching,
# SIGTERM/SIGKILL by pid to everything whose cmdline mentions the engine.
# Records the uid it ran as and every attempt's outcome, then carries on with
# a completely normal iteration: the point of the test is that the run
# *finishes* while the transcript shows the attempts were refused.
if os.environ.get("STUB_SIGNAL_ENGINE") and "Role: Worker" in prompt:
    import signal as _signal
    import subprocess as _subprocess

    _attempts = []
    try:
        _pk = _subprocess.run(["pkill", "-f", "ralphd-engine"],
                              capture_output=True, text=True)
        _attempts.append({"how": "pkill -f ralphd-engine", "rc": _pk.returncode,
                          "stderr": _pk.stderr.strip()[:200]})
    except OSError as _exc:
        _attempts.append({"how": "pkill -f ralphd-engine", "error": repr(_exc)})
    for _pid in sorted(int(_e) for _e in os.listdir("/proc") if _e.isdigit()):
        try:
            _cmdline = open(f"/proc/{_pid}/cmdline", "rb").read().decode(
                errors="replace")
        except OSError:
            continue
        if "ralphd-engine" not in _cmdline or _pid == os.getpid():
            continue
        for _signame, _sig in (("SIGTERM", _signal.SIGTERM),
                               ("SIGKILL", _signal.SIGKILL)):
            _rec = {"how": f"kill {_signame} {_pid}", "pid": _pid,
                    "cmdline": _cmdline.replace("\0", " ").strip()[:120]}
            try:
                os.kill(_pid, _sig)
                _rec["errno"] = None  # the signal was DELIVERED -- no boundary
            except OSError as _exc:
                _rec["errno"] = _exc.errno
                _rec["error"] = _exc.strerror
            _attempts.append(_rec)
    with open(marker("signal-engine.json"), "w") as _f:
        json.dump({"uid": os.getuid(), "euid": os.geteuid(),
                   "gid": os.getgid(), "attempts": _attempts}, _f, indent=1)


