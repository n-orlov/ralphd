#!/usr/bin/env python3
"""Recording stub `docker` for black-box ralphctl tests.

Appends every invocation's argv (JSON, one line) to $STUB_DOCKER_LOG and fakes
just enough behavior for ralphctl to proceed. Knobs:

  STUB_DOCKER_LOG             file to append argv lines to
  STUB_DOCKER_PS_IDS          comma-separated ids printed by `docker ps`
  STUB_DOCKER_INSPECT_LABELS  JSON {container_id: label_value} answered by
                              `docker inspect --format ...` (exit 1 if id absent)
  STUB_DOCKER_INSPECT_OK      if set, plain `docker inspect <name>` exits 0
                              (default: exit 1 = container does not exist)
  STUB_DOCKER_CONTAINERS      comma-separated names/ids that "exist" (for
                              `docker inspect --format {{.State.Running}}`)
  STUB_DOCKER_RUNNING         subset of STUB_DOCKER_CONTAINERS that are
                              currently running (rest are exited/stopped)
  STUB_DOCKER_LIVE_ENGINE     if set, `docker run` actually launches a real
                              `ralphd-engine` process (via
                              live_engine_supervisor.py) against the mounted
                              run/config/workspace dirs and the mapped port,
                              instead of only faking a container id. The
                              supervisor SIGKILLs the engine the instant its
                              status.json reaches a terminal state, so tests
                              can deterministically reproduce the API
                              dying right at job completion.
  STUB_DOCKER_IMAGES          comma-separated image refs that `docker image
                              inspect` finds. Set (even to empty) to make the
                              image cache answer honestly; unset means every
                              image "exists" (the pre-task-033 behaviour every
                              doctor test relies on).
  STUB_DOCKER_IMAGE_FILE      path to a file of image refs, one per line,
                              APPENDED to by `docker build -t <ref>` and read
                              by `docker image inspect` alongside
                              STUB_DOCKER_IMAGES -- so a build in one ralphctl
                              invocation is a cache hit in the next.
  STUB_DOCKER_BUILD_LINES     how many lines of fake build output `docker
                              build` prints (default 3).
  STUB_DOCKER_BUILD_FAIL      if set, `docker build` prints its output and
                              exits 1 without recording the tag.
  STUB_DOCKER_BUILD_DOCKERFILE  path to copy the `-f <dockerfile>` file's
                              CONTENT to, so a test can read the recipe that
                              was actually built (task 034's generated,
                              never-on-disk-in-the-repo derived Dockerfile).
"""
import json
import os
import subprocess
import sys

argv = sys.argv[1:]
log = os.environ.get("STUB_DOCKER_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps(argv) + "\n")

cmd = argv[0] if argv else ""


def _parse_run_argv(argv):
    """Extract -v mounts, -p host port, and -e env from a `docker run` argv."""
    mounts = {}
    port = None
    env = {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "-v" and i + 1 < len(argv):
            host, cont = argv[i + 1].split(":")[0], argv[i + 1].split(":")[1]
            mounts[cont] = host
            i += 2
            continue
        if a == "-p" and i + 1 < len(argv):
            bits = argv[i + 1].split(":")
            port = bits[-2]
            i += 2
            continue
        if a == "-e" and i + 1 < len(argv):
            k, _, v = argv[i + 1].partition("=")
            env[k] = v
            i += 2
            continue
        i += 1
    return mounts, port, env


def _known_images():
    """The image refs this stub daemon has, or None for "everything exists"."""
    listed = os.environ.get("STUB_DOCKER_IMAGES")
    path = os.environ.get("STUB_DOCKER_IMAGE_FILE")
    if listed is None and not path:
        return None
    refs = {r for r in (listed or "").split(",") if r}
    if path and os.path.exists(path):
        with open(path) as f:
            refs |= {line.strip() for line in f if line.strip()}
    return refs


if cmd == "run" and os.environ.get("STUB_DOCKER_LIVE_ENGINE"):
    mounts, port, extra_env = _parse_run_argv(argv)
    run_dir = mounts["/run/ralphd"]
    config_dir = mounts.get("/config", run_dir)
    workspace_dir = mounts.get("/workspace")
    supervisor = os.path.join(os.path.dirname(__file__), "live_engine_supervisor.py")
    sup_cmd = [sys.executable, supervisor, "--run-dir", run_dir,
               "--config-dir", config_dir, "--port", port or "0"]
    if workspace_dir:
        sup_cmd += ["--workspace-dir", workspace_dir]
    sup_env = {**os.environ, **extra_env}
    log_path = os.path.join(run_dir, ".stub-live-engine.log")
    with open(log_path, "ab") as logf:
        subprocess.Popen(sup_cmd, env=sup_env, stdout=logf, stderr=logf,
                          start_new_session=True)
    print("f" * 64)  # fake container id
    sys.exit(0)

if cmd == "run":
    print("f" * 64)  # fake container id
elif cmd == "ps":
    ids = os.environ.get("STUB_DOCKER_PS_IDS", "")
    if ids:
        print("\n".join(ids.split(",")))
elif cmd == "inspect":
    if "--format" in argv:
        fmt = argv[argv.index("--format") + 1]
        cid = argv[-1]
        if fmt == "{{.State.Running}}":
            containers = set(os.environ.get("STUB_DOCKER_CONTAINERS", "").split(",")) - {""}
            running = set(os.environ.get("STUB_DOCKER_RUNNING", "").split(",")) - {""}
            if cid not in containers:
                sys.exit(1)
            print("true" if cid in running else "false")
        else:
            labels = json.loads(os.environ.get("STUB_DOCKER_INSPECT_LABELS", "{}"))
            if cid not in labels:
                sys.exit(1)
            print(labels[cid])
    elif not os.environ.get("STUB_DOCKER_INSPECT_OK"):
        sys.exit(1)
elif cmd == "version":
    print("29.5.3")
elif cmd == "build":
    tag = argv[argv.index("-t") + 1] if "-t" in argv else None
    copy_to = os.environ.get("STUB_DOCKER_BUILD_DOCKERFILE")
    if copy_to and "-f" in argv:
        with open(argv[argv.index("-f") + 1]) as src, open(copy_to, "w") as dst:
            dst.write(src.read())
    lines = int(os.environ.get("STUB_DOCKER_BUILD_LINES", "3"))
    for i in range(lines):
        print(f"Step {i + 1}/{lines} : RUN true")
    if os.environ.get("STUB_DOCKER_BUILD_FAIL"):
        print("The command '/bin/sh -c false' returned a non-zero code: 1",
              file=sys.stderr)
        sys.exit(1)
    path = os.environ.get("STUB_DOCKER_IMAGE_FILE")
    if tag and path:
        with open(path, "a") as f:
            f.write(tag + "\n")
    print(f"Successfully tagged {tag}")
elif cmd == "image" and argv[1:2] == ["inspect"]:
    refs = _known_images()
    if refs is not None:
        sys.exit(0 if argv[-1] in refs else 1)
sys.exit(0)
