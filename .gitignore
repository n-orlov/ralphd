__pycache__/
*.pyc
*.egg-info/
dist/
build/
.venv/
.pytest_cache/
.ruff_cache/
.playwright-cli/

# scratch dirs left by docker e2e test fixtures if teardown is interrupted
.docker-e2e-tmp-*

# run evidence a ralphd job writes into its workspace (logs, reports,
# petitions, screenshots). It belongs to the run, not the repository: the
# engine reads a workspace petitions file from disk, so nothing here needs
# to be tracked.
/artifacts/

# JetBrains IDE settings
.idea/

# per-tier Allure results a CI job writes (ci.yml --alluredir)
allure-results*/
